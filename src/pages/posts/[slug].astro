---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostThumbnails from '../../components/PostThumbnails.astro'
import ProvenanceReplay from '../../components/ProvenanceReplay.astro'
import Comments from '../../components/Comments.astro'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { formatDate, formatAuthors } from '../../lib/site'
import HumanBadgeLight from '../../assets/not-by-ai/written-by-humans-white.svg'
import HumanBadgeDark from '../../assets/not-by-ai/written-by-humans-black.svg'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const { authors, originalUrl, writtenByHuman, thumbnails, provenance, replayProminent } = post.data

// A replay is only honest if it ends in exactly the text being shown, so an
// edit to the post that is not in its provenance file fails the build. A
// leading "# <title>" line in the provenance text is shown as the post title
// rather than in the body, so it is not expected in the body.
if (provenance) {
  const prov = JSON.parse(readFileSync(join(process.cwd(), 'public', provenance), 'utf8'))
  let expected = prov.text.trim()
  const header = expected.match(/^# (.*)\n/)
  if (header && header[1].trim() === post.data.title) expected = expected.slice(header[0].length).trim()
  if ((post.body ?? '').trim() !== expected)
    throw new Error(`Post ${post.id} differs from the text in its provenance file ${provenance}`)
}
// Label the repost link with the source host, e.g. "mip.sh".
const originalHost = originalUrl
  ? new URL(originalUrl).hostname.replace(/^www\./, '')
  : undefined
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  ogType="article"
>
  <article class="prose">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        {authors && authors.length > 0 && <span>{formatAuthors(authors)} · </span>}
        {formatDate(post.data.date)}
      </p>
      {
        originalUrl && (
          <p class="post-original">
            Originally posted at <a href={originalUrl}>{originalHost}</a>
          </p>
        )
      }
      {
        provenance && (
          <button
            type="button"
            class:list={['replay-open', { 'replay-open-prominent': replayProminent }]}
            data-replay-open
          >
            <span class="replay-open-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor" /></svg>
            </span>
            <span class="replay-open-text">
              <span class="replay-open-title" data-replay-open-label>Watch this being written</span>
              <span class="replay-open-sub">Evidence of human authorship</span>
            </span>
          </button>
        )
      }
    </header>
    <div data-post-body>
      <Content />
    </div>
    {provenance && <ProvenanceReplay src={provenance} />}
    {thumbnails && thumbnails.length > 0 && <PostThumbnails urls={thumbnails} />}
    {
      writtenByHuman && (
        <footer class="post-footer">
          <a
            class="human-badge"
            href="https://notbyai.fyi"
            target="_blank"
            rel="noopener noreferrer"
            title="Written by humans, not by AI"
          >
            {/* Light/dark variants toggled in CSS via the theme's --color-scheme */}
            <HumanBadgeLight class="badge-light" width={131} height={42} />
            <HumanBadgeDark class="badge-dark" width={131} height={42} />
          </a>
        </footer>
      )
    }
    <Comments threadId={`/posts/${post.id}/`} title={post.data.title} />
    <p><a href="/posts/">← All posts</a></p>
  </article>
</BaseLayout>
