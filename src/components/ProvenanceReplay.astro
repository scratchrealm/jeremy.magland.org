---
// Replay of a post being written, from an arewehuman provenance file. The
// trigger link lives in the post header ([data-replay-open]); when clicked,
// the formatted body ([data-post-body]) is hidden and this panel shows the
// raw Markdown as it was typed, in place. The .prov.json is fetched on first
// use, so the post costs nothing extra until then.
interface Props {
  src: string
}
const { src } = Astro.props
---

<div class="replay" data-replay data-src={src} hidden>
  <div class="replay-bar">
    <button type="button" class="replay-play" data-replay-play>❚❚ Pause</button>
    <input type="range" class="replay-seek" data-replay-seek min="0" max="1" step="any" value="0" aria-label="Replay position" />
    <span class="replay-clock" data-replay-clock></span>
    <select class="replay-speed" data-replay-speed aria-label="Replay speed">
      <option value="fast">Fast</option>
      <option value="normal" selected>Normal</option>
      <option value="slow">Slow</option>
      <option value="x10">Typing pace ×10</option>
      <option value="x5">Typing pace ×5</option>
      <option value="x2">Typing pace ×2</option>
      <option value="x1">Typing pace</option>
    </select>
    <button type="button" class="replay-close" data-replay-close>Back to the post</button>
  </div>
  <p class="replay-about">
    A replay of every keystroke, recorded with
    <a href="https://magland.github.io/arewehuman/" target="_blank" rel="noopener">arewehuman</a>
    as evidence that a person typed this post rather than generating it with AI.
  </p>
  <div class="replay-text" data-replay-text></div>
  <p class="replay-note">
    <span class="untyped">Highlighted</span> text was not typed.
    <span class="ghost">░░</span> marks text that was later deleted; its content was never recorded.
    Long pauses are shortened.
  </p>
</div>

<script>
  import { Timeline, type ProvDoc, type Run } from '../lib/provenance'

  // Replay timing, identical to the player in arewehuman (src/viewer/Replay.tsx).
  // For Fast/Normal/Slow, gaps up to PAUSE_MS are typing rhythm and keep their
  // proportions, sped up so that all typing takes `typing` seconds (or real
  // pace, if that is faster). A longer pause gets a beat that grows with the
  // log of its length (`beat` ms per factor of e). The typing-pace speeds use
  // the recorded timing played `mult` times faster. At every speed no pause is
  // shown for longer than MAX_SHOWN_MS.
  const PAUSE_MS = 3000
  const MAX_SHOWN_MS = 1000
  type Speed = { typing: number; beat: number } | { mult: number }
  const SPEEDS: Record<string, Speed> = {
    fast: { typing: 30, beat: 200 },
    normal: { typing: 60, beat: 430 },
    slow: { typing: 150, beat: 800 },
    x10: { mult: 10 },
    x5: { mult: 5 },
    x2: { mult: 2 },
    x1: { mult: 1 },
  }

  const panel = document.querySelector<HTMLElement>('[data-replay]')
  const opener = document.querySelector<HTMLButtonElement>('[data-replay-open]')
  const body = document.querySelector<HTMLElement>('[data-post-body]')
  if (panel && opener && body) setup(panel, opener, body)

  function setup(panel: HTMLElement, opener: HTMLButtonElement, body: HTMLElement) {
    const $ = <T extends HTMLElement>(sel: string) => panel.querySelector<T>(sel)!
    const playBtn = $<HTMLButtonElement>('[data-replay-play]')
    const seek = $<HTMLInputElement>('[data-replay-seek]')
    const clock = $<HTMLElement>('[data-replay-clock]')
    const speed = $<HTMLSelectElement>('[data-replay-speed]')
    const textEl = $<HTMLElement>('[data-replay-text]')
    const bar = $<HTMLElement>('.replay-bar')

    let tl: Timeline | null = null
    let events: ProvDoc['events'] = []
    let ct = new Float64Array(0) // replay time (ms) of each event
    let total = 0
    let pos = 0
    let playing = false
    let raf = 0
    let shownK = -1

    async function load() {
      if (tl) return
      const label = opener.querySelector<HTMLElement>('[data-replay-open-label]') ?? opener
      const text = label.textContent
      opener.disabled = true
      label.textContent = 'Loading…'
      try {
        const doc: ProvDoc = await (await fetch(panel.dataset.src!)).json()
        tl = new Timeline(doc)
        events = doc.events
        timing()
      } finally {
        opener.disabled = false
        label.textContent = text
      }
    }

    // Replay time of each event for the selected speed.
    function timing() {
      const sp = SPEEDS[speed.value] ?? SPEEDS.normal
      const gap = (i: number) => events[i][1] - events[i - 1][1]
      let shown: (g: number) => number
      if ('mult' in sp) shown = (g) => g / sp.mult
      else {
        let rhythm = 0
        for (let i = 1; i < events.length; i++) rhythm += Math.min(gap(i), PAUSE_MS)
        const scale = rhythm ? Math.min(1, (sp.typing * 1000) / rhythm) : 1
        shown = (g) => scale * Math.min(g, PAUSE_MS) + (g > PAUSE_MS ? sp.beat * Math.log(g / PAUSE_MS) : 0)
      }
      ct = new Float64Array(events.length)
      for (let i = 1; i < events.length; i++) ct[i] = ct[i - 1] + Math.min(shown(gap(i)), MAX_SHOWN_MS)
      total = events.length ? ct[events.length - 1] : 0
      seek.max = String(Math.ceil(total))
    }

    // Number of events applied at replay time p.
    function eventsAt(p: number) {
      let lo = 0
      let hi = events.length
      while (lo < hi) {
        const mid = (lo + hi) >> 1
        if (ct[mid] <= p) lo = mid + 1
        else hi = mid
      }
      return p <= 0 ? Math.min(1, events.length) : lo
    }

    const fmt = (ms: number) => {
      const s = Math.floor(ms / 1000)
      const h = Math.floor(s / 3600)
      const m = Math.floor((s % 3600) / 60)
      const ss = String(s % 60).padStart(2, '0')
      return h ? `${h}:${String(m).padStart(2, '0')}:${ss}` : `${m}:${ss}`
    }

    function render(follow: boolean) {
      const k = eventsAt(pos)
      seek.value = String(pos)
      if (k === shownK || !tl) return
      shownK = k
      const { runs, caret } = tl.stateAt(k)
      textEl.replaceChildren()
      const caretEl = document.createElement('span')
      caretEl.className = 'caret'
      let offset = 0
      const add = (s: string, r: Run) => {
        if (!s) return
        if (r.ghost || r.untyped) {
          const g = document.createElement('span')
          g.className = [r.ghost && 'ghost', r.untyped && 'untyped'].filter(Boolean).join(' ')
          g.textContent = s
          textEl.append(g)
        } else textEl.append(s)
      }
      for (const r of runs) {
        const cut = caret - offset
        if (cut >= 0 && cut < r.text.length) {
          add(r.text.slice(0, cut), r)
          textEl.append(caretEl)
          add(r.text.slice(cut), r)
        } else add(r.text, r)
        offset += r.text.length
      }
      if (caret === offset) textEl.append(caretEl)
      const end = events[events.length - 1]?.[1] ?? 0
      clock.textContent = `${fmt(events[k - 1]?.[1] ?? 0)} / ${fmt(end)}`
      if (follow && caretEl.isConnected) {
        // Keep the caret in view without fighting the reader more than needed.
        const r = caretEl.getBoundingClientRect()
        const top = bar.getBoundingClientRect().bottom + 16
        const bottom = window.innerHeight - 48
        if (r.bottom > bottom) window.scrollBy(0, r.bottom - bottom + window.innerHeight / 3)
        else if (r.top < top) window.scrollBy(0, r.top - top - window.innerHeight / 3)
      }
    }

    const label = () => (playing ? '❚❚ Pause' : pos >= total ? '↺ Replay' : '▶ Play')

    function setPlaying(p: boolean) {
      playing = p
      playBtn.textContent = label()
      cancelAnimationFrame(raf)
      if (!playing) return
      let last = performance.now()
      const step = (now: number) => {
        pos = Math.min(total, pos + (now - last))
        last = now
        render(true)
        if (pos >= total) setPlaying(false)
        else raf = requestAnimationFrame(step)
      }
      raf = requestAnimationFrame(step)
    }

    opener.addEventListener('click', async () => {
      await load()
      body.hidden = true
      panel.hidden = false
      opener.hidden = true
      pos = 0
      shownK = -1
      render(false)
      panel.scrollIntoView({ block: 'start' })
      setPlaying(true)
    })

    playBtn.addEventListener('click', () => {
      if (!playing && pos >= total) pos = 0
      setPlaying(!playing)
    })

    seek.addEventListener('input', () => {
      if (playing) setPlaying(false)
      pos = Math.min(total, Number(seek.value))
      render(false)
      playBtn.textContent = label()
    })

    // Keep the same point in the writing when the speed changes.
    speed.addEventListener('change', () => {
      if (!tl) return
      const k = eventsAt(pos)
      const atEnd = pos >= total
      timing()
      pos = atEnd ? total : ct[Math.max(0, k - 1)]
      render(false)
    })

    $<HTMLButtonElement>('[data-replay-close]').addEventListener('click', () => {
      setPlaying(false)
      panel.hidden = true
      body.hidden = false
      opener.hidden = false
      opener.scrollIntoView({ block: 'nearest' })
    })
  }
</script>
