---
// The most recent posts, for the home page: a light list of title + date,
// with a link to the full listing at /posts. Only featured posts (the default;
// `featured: false` in the frontmatter opts out) are candidates, and of those
// only the `count` most recent are shown.
import { formatDate } from '../lib/site'
import { getPosts } from '../lib/posts'

interface Props {
  count?: number
}

const { count = 3 } = Astro.props
const posts = (await getPosts()).filter((p) => p.featured).slice(0, count)
---

{
  posts.length > 0 && (
    <section class="recent-posts">
      <h2>Recent posts</h2>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`}>{post.title}</a>
            <span class="date">{formatDate(post.date)}</span>
          </li>
        ))}
      </ul>
      <p>
        <a href="/posts/">All posts →</a>
      </p>
    </section>
  )
}

<style>
  .recent-posts ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recent-posts li {
    margin: 0.4rem 0;
  }

  .recent-posts .date {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-left: 0.6rem;
    white-space: nowrap;
  }
</style>
