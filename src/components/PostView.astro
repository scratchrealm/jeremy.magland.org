---
// A post's page, shared by published posts (/posts/<id>/) and drafts
// (/drafts/<id>/). A draft says so in place of its date, is not indexed, and
// has no comments.
import { render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostThumbnails from './PostThumbnails.astro'
import ProvenanceReplay from './ProvenanceReplay.astro'
import Comments from './Comments.astro'
import { formatDate, formatAuthors } from '../lib/site'
import type { Post } from '../lib/posts'
import HumanBadgeLight from '../assets/not-by-ai/written-by-humans-white.svg'
import HumanBadgeDark from '../assets/not-by-ai/written-by-humans-black.svg'

interface Props {
  post: Post
}

const { post } = Astro.props
const { Content } = await render(post.entry)

const { title, summary, date, authors, writtenByHuman, provenance, draft, scripts } = post
const { originalUrl, thumbnails, replayProminent } = post.entry.data
// Label the repost link with the source host, e.g. "mip.sh".
const originalHost = originalUrl
  ? new URL(originalUrl).hostname.replace(/^www\./, '')
  : undefined
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  noindex={draft}
  scripts={scripts}
>
  <article class="prose">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        {authors.length > 0 && <span>{formatAuthors(authors)} · </span>}
        {draft ? <span class="post-draft">Draft, not published</span> : <span data-pagefind-meta="date">{formatDate(date)}</span>}
      </p>
      {
        originalUrl && (
          <p class="post-original">
            Originally posted at <a href={originalUrl}>{originalHost}</a>
          </p>
        )
      }
      {
        provenance && (
          <button
            type="button"
            class:list={['replay-open', { 'replay-open-prominent': replayProminent }]}
            data-replay-open
            data-pagefind-ignore
          >
            <span class="replay-open-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="14" height="14"><path d="M5 3.2v9.6L12.6 8z" fill="currentColor" /></svg>
            </span>
            <span class="replay-open-text">
              <span class="replay-open-title" data-replay-open-label>Watch this being written</span>
              <span class="replay-open-sub">Evidence of human authorship</span>
            </span>
          </button>
        )
      }
    </header>
    <div data-post-body>
      <Content />
    </div>
    {provenance && <ProvenanceReplay src={provenance.url} />}
    {thumbnails && thumbnails.length > 0 && <PostThumbnails urls={thumbnails} />}
    {
      writtenByHuman && (
        <footer class="post-footer" data-pagefind-ignore>
          <a
            class="human-badge"
            href="https://notbyai.fyi"
            target="_blank"
            rel="noopener noreferrer"
            title="Written by humans, not by AI"
          >
            {/* Light/dark variants toggled in CSS via the theme's --color-scheme */}
            <HumanBadgeLight class="badge-light" width={131} height={42} />
            <HumanBadgeDark class="badge-dark" width={131} height={42} />
          </a>
        </footer>
      )
    }
    {!draft && <Comments threadId={post.url} title={title} />}
    <p data-pagefind-ignore>{draft ? <a href="/drafts/">← All drafts</a> : <a href="/posts/">← All posts</a>}</p>
  </article>
</BaseLayout>
